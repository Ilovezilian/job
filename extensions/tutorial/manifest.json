{
  "name": "shuai",
  "version": "0.0.0.1",
  "manifest_version": 3,
  "description": "An extension to display the NASA picture of the day.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/jquery.min.js",
        "content-scripts/content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/*.jpeg",
        "images/*.jpg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}